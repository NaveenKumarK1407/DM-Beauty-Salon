# ── Site ──────────────────────────────────────────────────
# Public base URL (used for SEO canonical links, sitemap, robots, OG tags)
NEXT_PUBLIC_SITE_URL=https://dmbeauty.in

# ── Firebase Web SDK (client) — for push notification opt-in ─
# From Firebase console → Project settings → General → Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging → Web Push certificates → Key pair (public VAPID key)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Firebase Admin SDK (server) — for Firestore + sending FCM ─
# EITHER paste the full service-account JSON (single line / base64 also works)...
FIREBASE_SERVICE_ACCOUNT_KEY=
# ...OR provide the three discrete fields below instead:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes; the app converts them to real newlines.
FIREBASE_PRIVATE_KEY=

# ── Cron (8 PM appointment reminders) ───────────────────────
# Set a random secret; call GET /api/cron/appointment-reminders with header:
# Authorization: Bearer YOUR_SECRET  (or ?force=1 to test anytime)
CRON_SECRET=

# NOTE: Without these vars the app still runs end-to-end — bookings/messages are
# written to a local .data/ JSON store and notifications are logged to the console.
